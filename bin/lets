#!/bin/sh
# lets: LETS's own command (Linux and macOS; Python 3.11 or newer).
here="$(dirname "$(readlink -f "$0")")"
if ! command -v python3 >/dev/null 2>&1; then
  echo "LETS needs Python 3.11 or newer, and python3 isn't installed." >&2
  echo "  Ubuntu or Debian: sudo apt install python3" >&2
  echo "  macOS:            brew install python" >&2
  exit 1
fi
exec python3 -I "$here/../lib/lets/__main__.py" "$@"
