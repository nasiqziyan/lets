{
  "name": "@nasiq/lets",
  "version": "1.1.0",
  "description": "LETS: one way of working with coding agents in Claude Code and Codex: plan, build in pairs, review, walk through.",
  "keywords": [
    "claude-code",
    "codex",
    "agent-skills",
    "spec-driven-development",
    "openspec",
    "workflow"
  ],
  "license": "MIT",
  "author": "Nasiq Ziyan",
  "homepage": "https://github.com/nasiqziyan/lets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nasiqziyan/lets.git"
  },
  "bugs": {
    "url": "https://github.com/nasiqziyan/lets/issues"
  },
  "scripts": {
    "version": "python3 scripts/maint.py build && git add plugin"
  },
  "bin": {
    "lets": "bin/lets"
  },
  "files": [
    "bin/",
    "lib/lets/*.py",
    "agent-hooks/",
    "plugin/",
    ".agents/plugins/marketplace.json",
    "guides/",
    "profile/",
    "openspec/config.yaml",
    "docs/",
    "!docs/images/",
    "AGENTS.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "@fission-ai/openspec": "1.15.0"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
