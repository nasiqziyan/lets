{
  "description": "LETS guard: checks every shell command and file edit an agent makes; and a check at session start",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/lets/agent-hooks/guard.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/lets/agent-hooks/session-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
